# ─────────────────────────────────────────────────────────────────────────────
# Client Environment Configuration
# Copy this file to .env or .env.local for local development.
# ─────────────────────────────────────────────────────────────────────────────

# Backend API Base URL (leave empty or set production URL when deploying)
# For local development with backend running on port 5000:
VITE_API_BASE_URL=http://localhost:5000

# For production deployment (e.g. Vercel / Netlify):
# VITE_API_BASE_URL=https://your-portfolio-api.onrender.com
