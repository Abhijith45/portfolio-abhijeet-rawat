# ─── Application ──────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Frontend URL for CORS whitelist
CLIENT_URL=http://localhost:5173

# ─── Database ─────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/portfolio?retryWrites=true&w=majority

# ─── Authentication ───────────────────────────────────────────────────────────
# Use a strong random string (min 32 chars). Generate: openssl rand -hex 32
JWT_SECRET=your_strong_random_jwt_secret_here_min_32_chars

# ─── Email Notifications (Nodemailer) ─────────────────────────────────────────
# Target inbox where contact inquiries will be received
CONTACT_RECEIVER_EMAIL=your_email@gmail.com

# Gmail sender credentials
# For Gmail: create an App Password at https://myaccount.google.com/apppasswords
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_16_digit_app_password

# ─── Custom SMTP (optional — leave blank when using Gmail above) ───────────────
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# ─── Cloudinary (optional — for image hosting) ────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Resume fallback URL ───────────────────────────────────────────────────────
DEFAULT_RESUME_URL=https://drive.google.com/file/d/<your-drive-file-id>/view

# ─── Admin Seeding (for initial setup only) ───────────────────────────────────
# Used by server/seed.js — run once then keep private
ADMIN_EMAIL=admin@yourportfolio.dev
ADMIN_PASSWORD=Change_This_Strong_Password!
